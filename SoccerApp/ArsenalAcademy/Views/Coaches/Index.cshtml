@model List<ViewCoachViewModel>

@{
}

<table class="table table-striped table-hover text-center">
    <thead>
        <tr>
            <th scope="col">First Name</th>
            <th scope="col">Last Name</th>
            <th scope="col">Team</th>
            <th scope="col">Coaching License</th>
            <th scope="col">Started Coaching</th>
            <th scope="col"></th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (ViewCoachViewModel coach in Model)
        {
            <tr>
                <td>@coach.FirstName</td>
                <td>@coach.LastName</td>
                @if (!string.IsNullOrWhiteSpace(@coach.TeamName))
                {
                    <td>@coach.TeamName</td>
                }
                else
                {
                    <td>No team assigned currently.</td>
                }
                <td>@coach.CoachingLicense</td>
                <td>@coach.StartedCoachingDate.Year</td>
                <td><a class="btn btn-link" asp-controller="coaches" asp-action="getcoach" asp-route-Id="@coach.CoachId">View</a></td>
            </tr>
        }
    </tbody>
</table>
<div class="row text-center justify-content-center">
    <div class="col-4">
        <a role="button" class="btn btn-success" asp-controller="coaches" asp-action="createcoach">New Coach</a>
        <a role="button" class="btn btn-primary" asp-controller="home" asp-action="index">Home</a>
    </div>
</div>

