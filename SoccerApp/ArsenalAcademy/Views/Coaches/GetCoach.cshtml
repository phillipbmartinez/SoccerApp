@model CoachViewModel

@{
}

<div class="row text-center">
    <h2>Coach</h2>
</div>
<div class="row">
    <table class="table table-striped table-hover text-center">
        <thead>
            <tr>
                <th scope="col">Coach Id</th>
                <th scope="col">Coaching License</th>
                <th scope="col">Started Coaching</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.CoachId > 0)
            {
                <tr>
                    <td>@Model.CoachId</td>
                    <td>@Model.CoachingLicense</td>
                    <td>@Model.StartedCoachingDate.Year</td>
                </tr>
            }
            else
            {
                <tr>
                    <td>Coach not found.</td>
                    <td></td>
                    <td></td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="row text-center justify-content-center">
    <div class="col-4">
        <a role="button" class="btn btn-success" asp-controller="coaces" asp-action="editcoach">Submit</a>
        <a role="button" class="btn btn-primary" asp-controller="coaches" asp-action="index">Back</a>
    </div>
</div>

