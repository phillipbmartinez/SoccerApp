@model List<ViewTeamCoachViewModel>

@{
}

<table class="table table-striped table-hover text-center">
    <thead>
        <tr>
            <th scope="col">Team Name</th>
            <th scope="col">Age Group</th>
            <th scope="col">Head Coach</th>
            <th scope="col"></th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (ViewTeamCoachViewModel team in Model)
        {
            <tr>
                <td>@team.TeamName.</td>
                <td>@team.AgeGroup</td>
                <td>@team.CoachFirstName @team.CoachLastName</td>
                <td><a class="btn btn-link" asp-controller="games" asp-action="getteamgames" asp-route-Id="@team.TeamId">Games</a></td>
                <td><a class="btn btn-link" asp-controller="players" asp-action="getteamplayers" asp-route-Id="@team.TeamId">Players</a></td>
            </tr>
        }
    </tbody>
</table>
<div class="row text-center justify-content-center">
    <div class="col-4">
        <a role="button" class="btn btn-primary" asp-controller="home" asp-action="index">Home</a>
    </div>
</div>

