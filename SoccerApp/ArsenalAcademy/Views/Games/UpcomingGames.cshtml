@model List<ViewGameTeamOpponentViewModel>

@{
}

<table class="table table-striped table-hover text-center">
    <thead>
        <tr>
            <th scope="col">Date / Time</th>
            <th scope="col">Location</th>
            <th scope="col">Status</th>
            <th scope="col">Age Group</th>
            <th scope="col">Home Team</th>
            <th scope="col">Away Team</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (ViewGameTeamOpponentViewModel game in Model)
        {
            <tr>
                <td>@game.GameDate.</td>
                <td>@game.GameLocation</td>
                <td>@game.GameStatus</td>
                <td>@game.AgeGroup</td>
                <td>@game.TeamName</td>
                <td>@game.OpponentName</td>
                <td><a class="btn btn-link" asp-controller="games" asp-action="getgame" asp-route-Id="@game.GameId">View</a></td>
            </tr>
        }
    </tbody>
</table>
<div class="row text-center justify-content-center">
    <div class="col-4">
        <a role="button" class="btn btn-primary" asp-controller="home" asp-action="index">Home</a>
    </div>
</div>

